@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Blogaat Admin</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Blogaat.styles.css" asp-append-version="true" />
</head>

<body class="bg-gray-100 min-h-screen flex font-sans">

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-64 bg-white min-h-screen fixed top-0 left-0 transform -translate-x-full transition-transform duration-300 z-50 md:relative md:translate-x-0 md:block shadow-lg border-r border-gray-200">

        <div class="p-6 border-b">
            <a asp-controller="Home" asp-action="Index" class="text-2xl font-extrabold text-gray-900">
                Blogaat Admin
            </a>
        </div>

        <nav class="flex flex-col px-6 py-4 space-y-2 text-sm text-gray-700">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 hover:bg-gray-100 px-3 py-2 rounded">
                <i class="fas fa-home text-gray-500"></i> Home
            </a>
            <a asp-controller="AdminTags" asp-action="Add" class="flex items-center gap-2 hover:bg-gray-100 px-3 py-2 rounded">
                <i class="fas fa-plus-circle text-gray-500"></i> Add Tag
            </a>
            <a asp-controller="AdminTags" asp-action="GetALL" class="flex items-center gap-2 hover:bg-gray-100 px-3 py-2 rounded">
                <i class="fas fa-tags text-gray-500"></i> Show Tags
            </a>
            <a asp-controller="AdminBlogPosts" asp-action="Add" class="flex items-center gap-2 hover:bg-gray-100 px-3 py-2 rounded">
                <i class="fas fa-pen text-gray-500"></i> Add Blog
            </a>
            <a asp-controller="AdminBlogPosts" asp-action="GetALL" class="flex items-center gap-2 hover:bg-gray-100 px-3 py-2 rounded">
                <i class="fas fa-file-alt text-gray-500"></i> Show Blogs
            </a>
            <a asp-controller="AdminUsers" asp-action="Users" class="flex items-center gap-2 hover:bg-gray-100 px-3 py-2 rounded">
                <i class="fas fa-users text-gray-500"></i> Users
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col w-full">

        <!-- Top Navbar -->
        <header class="bg-white shadow px-6 py-4 flex justify-between items-center border-b">
            <!-- Sidebar Toggle Button -->
            <button id="menu-toggle" class="md:hidden text-gray-800 focus:outline-none text-xl">
                ☰
            </button>

@*             <h1 class="text-xl font-semibold text-gray-800">@ViewData["Title"]</h1>

            <div class="flex items-center gap-4">
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="text-sm text-gray-700">Hello, <strong>@User.Identity.Name</strong></span>
                    <a asp-controller="Account" asp-action="Logout"
                       class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600 text-sm transition">
                        Logout
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       class="bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600 text-sm transition">
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register"
                       class="bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600 text-sm transition">
                        Register
                    </a>
                }
            </div> *@
        </header>

        <!-- Body -->
        <main class="p-6">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-gray-100 text-gray-600 text-center text-sm py-4 border-t">
            &copy; 2024 - Blogaat Admin - <a asp-controller="Home" asp-action="Index" class="text-blue-500 hover:underline">Home</a>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const toggleButton = document.getElementById('menu-toggle');
        const sidebar = document.getElementById('sidebar');

        toggleButton?.addEventListener('click', () => {
            sidebar.classList.toggle('-translate-x-full');
        });
    </script>

</body>
</html>
