@model Blogaat.Models.ViewModels.EditBlogPostVM

@{
    ViewData["Title"] = "Edit Blog Post";
    Layout = "_Layout"; // Layout الإداري الأساسي (Tailwind)
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Edit Blog Post</h1>
        <a asp-controller="AdminBlogPosts" asp-action="GetALL"
           class="text-sm px-4 py-2 bg-gray-800 text-white rounded hover:bg-gray-700 transition">
            ← Back
        </a>
    </div>

    @if (Model != null)
    {
        <form method="post" enctype="multipart/form-data" asp-controller="AdminBlogPosts" asp-action="SaveEditblog"
              class="bg-white shadow rounded p-6 space-y-6">

            <div>
                <label for="ID" class="block text-sm font-medium">ID</label>
                <input class="w-full border rounded px-3 py-2 bg-gray-100" type="text" id="ID" asp-for="Id" readonly>
            </div>

            <div>
                <label asp-for="Heading" class="block text-sm font-medium">Heading</label>
                <input asp-for="Heading" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="Heading" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="PageTitle" class="block text-sm font-medium">Page Title</label>
                <input asp-for="PageTitle" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="PageTitle" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Content" class="block text-sm font-medium">Content</label>
                <textarea asp-for="Content" id="content" class="w-full border rounded px-3 py-2"></textarea>
            </div>

            <div>
                <label asp-for="ShortDescription" class="block text-sm font-medium">Short Description</label>
                <input asp-for="ShortDescription" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="ShortDescription" class="text-red-500 text-sm"></span>
            </div>

            <!-- Upload Image -->
            <div>
                <label for="FeateredImageupload" class="block text-sm font-medium">Upload Image</label>
                <input type="file" id="FeateredImageupload" name="file"
                       class="block w-full border px-3 py-2 rounded text-sm" accept="image/*" />

                <img id="Display" class="mt-3 rounded shadow w-48"
                     src="@Model.FeateredImageUrl" style="@(Model.FeateredImageUrl != null ? "display:block;" : "display:none;")" />
            </div>

            <div>
                <label asp-for="FeateredImageUrl" class="block text-sm font-medium">Featured Image URL</label>
                <input asp-for="FeateredImageUrl" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="FeateredImageUrl" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="UrlHandle" class="block text-sm font-medium">URL Handle</label>
                <input asp-for="UrlHandle" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="UrlHandle" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="PublishedDate" class="block text-sm font-medium">Published Date</label>
                <input asp-for="PublishedDate" type="date" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="PublishedDate" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Author" class="block text-sm font-medium">Author</label>
                <input asp-for="Author" class="w-full border rounded px-3 py-2" />
                <span asp-validation-for="Author" class="text-red-500 text-sm"></span>
            </div>

            <div class="flex items-center gap-2">
                <input asp-for="Visible" type="checkbox" class="form-checkbox text-blue-600" />
                <label asp-for="Visible" class="text-sm font-medium">Is Visible?</label>
            </div>

            <div>
                <label asp-for="SelectedTags" class="block text-sm font-medium">Tags</label>
                <select asp-items="@Model.Tags" asp-for="SelectedTags"
                        class="w-full border rounded px-3 py-2 bg-white">
                </select>
            </div>

            <div class="flex gap-4">
                <button type="submit"
                        class="px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-500 transition">
                    Update
                </button>

                <button type="submit" asp-action="Delete" asp-controller="AdminBlogPosts"
                        class="px-5 py-2 bg-red-600 text-white text-sm font-medium rounded hover:bg-red-500 transition">
                    Delete
                </button>
            </div>
        </form>
    }
    else
    {
        <div class="text-center text-red-500 mt-10">This blog post is not found.</div>
    }
</div>

<!-- Froala CSS + JS -->
<link href="~/css/froala_editor.pkgd.min.css" rel="stylesheet" />
<script src="~/js/froala_editor.pkgd.min.js"></script>

@section Scripts {
    <script>
        new FroalaEditor('#content', {
            imageUploadURL: '/api/ImageUpload'
        });

        // Preview & Upload Image
        document.getElementById("FeateredImageupload").addEventListener("change", function (event) {
            const reader = new FileReader();
            reader.onload = function () {
                const output = document.getElementById('Display');
                output.src = reader.result;
                output.style.display = "block";
            };
            reader.readAsDataURL(event.target.files[0]);

            const formData = new FormData();
            formData.append("file", event.target.files[0]);

            fetch('/api/ImageUpload', {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    document.getElementById("FeateredImageUrl").value = data.link;
                    document.getElementById("Display").src = data.link;
                })
                .catch(error => {
                    console.error("Image upload error:", error);
                });
        });
    </script>
}
