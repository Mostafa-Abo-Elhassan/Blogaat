@model Blogaat.Models.ViewModels.AddBlogPostVM

@{
    ViewData["Title"] = "Add Blog Post";
    Layout = "_Layout"; // تأكد إنه admin layout اللي بيحتوي Tailwind
}

<!-- Froala Editor CSS -->
<link href="~/css/froala_editor.pkgd.min.css" rel="stylesheet" />

<!-- Form Container -->
<div class="max-w-4xl mx-auto mt-10 bg-white p-8 rounded shadow-md">
    <h2 class="text-2xl font-semibold mb-6">Add New Blog Post</h2>

    <form method="post" enctype="multipart/form-data" asp-action="SaveAdd" id="uploadForm">

        <!-- Heading -->
        <div class="mb-4">
            <label for="Heading" class="block mb-1 font-medium">Heading</label>
            <input type="text" asp-for="Heading" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="Heading" class="text-red-500 text-sm"></span>
        </div>

        <!-- Page Title -->
        <div class="mb-4">
            <label for="PageTitle" class="block mb-1 font-medium">Page Title</label>
            <input type="text" asp-for="PageTitle" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="PageTitle" class="text-red-500 text-sm"></span>
        </div>

        <!-- Content (Froala) -->
        <div class="mb-4">
            <label class="block mb-1 font-medium">Content</label>
            <textarea asp-for="Content" id="content" class="w-full border rounded"></textarea>
        </div>

        <!-- Short Description -->
        <div class="mb-4">
            <label for="ShortDescription" class="block mb-1 font-medium">Short Description</label>
            <input type="text" asp-for="ShortDescription" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="ShortDescription" class="text-red-500 text-sm"></span>
        </div>

        <!-- Upload Image & Preview -->
        <div class="mb-4">
            <label class="block mb-1 font-medium">Upload Image</label>
            <input type="file" id="FeateredImageupload" name="file" accept="image/*"
                   class="w-full px-4 py-2 border rounded" />
            <img id="Display" style="display:none; width:200px; margin-top:10px;" class="rounded shadow" />
        </div>

        <!-- Featered Image URL -->
        <div class="mb-4">
            <label for="FeateredImageUrl" class="block mb-1 font-medium">Featured Image URL</label>
            <input type="text" asp-for="FeateredImageUrl" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="FeateredImageUrl" class="text-red-500 text-sm"></span>
        </div>

        <!-- Url Handle -->
        <div class="mb-4">
            <label for="UrlHandle" class="block mb-1 font-medium">Url Handle</label>
            <input type="text" asp-for="UrlHandle" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="UrlHandle" class="text-red-500 text-sm"></span>
        </div>

        <!-- Published Date -->
        <div class="mb-4">
            <label for="PublishedDate" class="block mb-1 font-medium">Published Date</label>
            <input type="date" asp-for="PublishedDate" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="PublishedDate" class="text-red-500 text-sm"></span>
        </div>

        <!-- Author -->
        <div class="mb-4">
            <label for="Author" class="block mb-1 font-medium">Author</label>
            <input type="text" asp-for="Author" class="w-full px-4 py-2 border rounded" />
            <span asp-validation-for="Author" class="text-red-500 text-sm"></span>
        </div>

        <!-- Visible Checkbox -->
        <div class="mb-4 flex items-center gap-2">
            <input type="checkbox" asp-for="Visible" class="h-4 w-4" />
            <label for="Visible" class="text-sm font-medium">Is Visible?</label>
        </div>

        <!-- Tags Dropdown -->
        <div class="mb-6">
            <label class="block mb-1 font-medium">Tags</label>
            <select asp-for="SelectedTags" asp-items="Model.Tags" class="w-full px-4 py-2 border rounded">
                <option value="">-- Select --</option>
            </select>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full bg-gray-900 text-white py-2 rounded hover:bg-gray-800">
            Submit
        </button>
    </form>
</div>

<!-- Froala Editor JS -->
<script src="~/js/froala_editor.pkgd.min.js"></script>

@section Scripts {
    <script>
        // Init Froala Editor
        new FroalaEditor('#content', {
            imageUploadURL: '/api/ImageUpload'
        });

        // Preview & Upload Image
        document.getElementById("FeateredImageupload").addEventListener("change", function (event) {
            const reader = new FileReader();
            reader.onload = function () {
                const output = document.getElementById('Display');
                output.src = reader.result;
                output.style.display = "block";
            };
            reader.readAsDataURL(event.target.files[0]);

            const formData = new FormData();
            formData.append("file", event.target.files[0]);

            fetch('/api/ImageUpload', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById("FeateredImageUrl").value = data.link;
            })
            .catch(error => console.error("Image upload error:", error));
        });
    </script>
}
