@model Blogaat.Models.ViewModels.usersVM

<div class="container mx-auto px-4 py-6">
    <h3 class="text-3xl font-bold mb-6 text-gray-800">Show All Users</h3>

    <!-- Create User Button -->
    <div class="flex justify-end mb-4">
        <button onclick="document.getElementById('createUserModal').classList.remove('hidden')"
                class="bg-gray-800 hover:bg-gray-700 text-white px-4 py-2 rounded shadow">
            Create User
        </button>
    </div>

    <!-- Users Table -->
    @if (Model != null)
    {
        <div class="overflow-x-auto bg-white rounded shadow">
            <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-2">ID</th>
                        <th class="px-4 py-2">User Name</th>
                        <th class="px-4 py-2">Email</th>
                        <th class="px-4 py-2">Role</th>
                        <th class="px-4 py-2">Delete</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="px-4 py-2">@user.Id</td>
                            <td class="px-4 py-2">@user.UserName</td>
                            <td class="px-4 py-2">@user.Email</td>
                            <td class="px-4 py-2">@user.RoleName</td>
                            <td class="px-4 py-2">
                              @*   @if (User.IsInRole("Admin") && !User.IsInRole("SuperAdmin") && !User.IsInRole("User"))
                                {
                                    if (user.RoleName.Contains("SuperAdmin"))
                                    {
                                        <span class="text-red-500 font-semibold">Cannot delete SuperAdmin</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Delete" asp-controller="AdminUsers" asp-route-Id="@user.Id">
                                            <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-500">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                } *@

                                @if (User.IsInRole("Admin"))
                                {
                                    if (user.RoleName.Contains("SuperAdmin") && !User.IsInRole("SuperAdmin"))
                                    {
                                        <span class="text-red-500 font-semibold">Cannot delete SuperAdmin</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Delete" asp-controller="AdminUsers" asp-route-Id="@user.Id">
                                            <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-500">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                }


                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-gray-500 mt-4">No Users Found!</p>
    }
</div>

<!-- Modal -->
<div id="createUserModal" class="fixed inset-0 z-50 bg-black bg-opacity-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold text-gray-800">Create New User</h2>
            <button onclick="document.getElementById('createUserModal').classList.add('hidden')" class="text-gray-500 hover:text-gray-800">&times;</button>
        </div>

        <form method="post" asp-action="CreateUser" asp-controller="AdminUsers" class="space-y-4">
            <div>
                <label asp-for="UserName" class="block text-sm font-medium text-gray-700">Username</label>
                <input asp-for="UserName" type="text" required class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:ring focus:ring-indigo-200" />
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700">Email</label>
                <input asp-for="Email" type="email" required class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:ring focus:ring-indigo-200" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Password</label>
                <input asp-for="Password" type="password" required class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:ring focus:ring-indigo-200" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                <div class="flex gap-4">
                    <div class="flex items-center">
                        <input type="checkbox" id="RoleUser" name="checkUser" value="User" checked class="mr-2">
                        <label for="RoleUser" class="text-sm">User</label>
                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="flex items-center">
                            <input type="checkbox" id="RoleAdmin" asp-for="checkAdmin" class="mr-2">
                            <label for="RoleAdmin" class="text-sm">Admin</label>
                        </div>
                    }
                </div>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
                <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded hover:bg-gray-700">
                    Create User
                </button>
                <button type="button" onclick="document.getElementById('createUserModal').classList.add('hidden')"
                        class="bg-gray-300 text-gray-800 px-4 py-2 rounded hover:bg-gray-400">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>
