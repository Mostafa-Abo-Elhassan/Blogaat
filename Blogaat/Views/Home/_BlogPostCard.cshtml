@model List<Blogaat.Models.Domains.BlogPost>

@foreach (var Blogaat in Model)
{
    <div class="bg-white dark:bg-gray-900 rounded-lg shadow hover:shadow-lg transition overflow-hidden flex flex-col">
        <img src="@Blogaat.FeateredImageUrl" alt="@Blogaat.Heading" class="w-full h-48 object-cover">
        <div class="p-5 flex-1 flex flex-col">
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-2">@Blogaat.PageTitle</h3>
            <div class="text-sm text-gray-500 dark:text-gray-300 mb-2">
                <div>Author: <span class="text-blue-600 dark:text-blue-400">@Blogaat.Author</span></div>
                <div>Published: @Blogaat.PublishedDate.ToString("MMMM dd, yyyy")</div>
            </div>
            <div class="flex flex-wrap gap-2 my-2">
                @foreach (var tag in Blogaat.tags)
                {
                    <span class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-white text-xs px-2 py-1 rounded-full">@tag.Name</span>
                }
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm flex-1">@Blogaat.ShortDescription</p>
        </div>
        <div class="p-5 border-t border-gray-200 dark:border-gray-700">
            <a class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-500 transition text-sm"
               asp-action="Index"
               asp-controller="Blogs"
               asp-route-id="@Blogaat.Id">
                Read More
            </a>
        </div>
    </div>
}
