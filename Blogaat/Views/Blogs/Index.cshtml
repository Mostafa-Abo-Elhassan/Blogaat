@model Blogaat.Models.Domains.BlogPost

@{
    ViewData["Title"] = Model.PageTitle;
    Layout = "_Home";
}

<section class="py-16 bg-white">
    <div class="container mx-auto px-4">
        @if (Model != null)
        {
            <!-- Heading -->
            <div class="max-w-3xl mx-auto mb-6">
                <h1 class="text-4xl font-bold text-gray-900 leading-tight">@Model.Heading</h1>
                <div class="flex justify-between items-center mt-2 text-sm text-gray-500">
                    <span>By <span class="text-blue-600 font-medium">@Model.Author</span></span>
                    <span>@Model.PublishedDate.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>

            <!-- Tags -->
            <div class="max-w-3xl mx-auto mb-6">
                <div class="flex flex-wrap gap-2">
                    @if (Model.tags != null && Model.tags.Any())
                    {
                        foreach (var tag in Model.tags)
                        {
                            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-3 py-1 rounded-full">@tag.Name</span>
                        }
                    }
                    else
                    {
                        <span class="text-gray-400 text-sm">No tags available.</span>
                    }
                </div>
            </div>

            <!-- Image -->
            <div class="max-w-3xl mx-auto mb-8">
                <img src="@Model.FeateredImageUrl" alt="@Model.Heading"
                     class="rounded-lg shadow-md w-full max-h-[500px] object-cover">
            </div>

            <!-- Content -->
            <div class="max-w-3xl mx-auto prose prose-lg dark:prose-invert">
                @Html.Raw(Model.Content)
            </div>

            <!-- Back to Home Button -->
            <div class="max-w-3xl mx-auto mt-12 text-center">
                <a href="@Url.Action("Index", "Home")"
                   class="inline-block px-6 py-2 bg-gray-800 text-white rounded hover:bg-gray-700 transition">
                    ← Back to Home
                </a>
            </div>
        }
        else
        {
            <p class="text-center text-red-500 text-lg font-semibold">This Blog is Not Found</p>
        }
    </div>
</section>
