@model Blogaat.Models.ViewModels.EditTagVM

@{
    ViewData["Title"] = "Edit Tag";
    Layout = "_Layout"; // Admin Layout
}

<div class="max-w-xl mx-auto bg-white p-6 rounded-lg shadow mt-8">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold text-gray-800">✏️ Edit Tag</h2>
        <a asp-controller="AdminTags" asp-action="GetALL"
           class="text-sm text-blue-600 hover:underline">
            ⬅ Back to Tags
        </a>
    </div>

    @if (Model != null)
    {
        <form method="post" asp-controller="AdminTags" asp-action="SaveEdit" class="space-y-4">

            <!-- ID (readonly) -->
            <div>
                <label for="id" class="block text-sm font-medium text-gray-700">ID</label>
                <input type="text" id="id" asp-for="Id" readonly
                       class="mt-1 block w-full rounded border-gray-300 shadow-sm bg-gray-100 cursor-not-allowed" />
            </div>

            <!-- Name -->
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
                <input type="text" id="name" asp-for="Name" required
                       class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
            </div>

            <!-- Display Name -->
            <div>
                <label for="displayName" class="block text-sm font-medium text-gray-700">Display Name</label>
                <input type="text" id="displayName" asp-for="DisplayName" required
                       class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" />
                <span asp-validation-for="DisplayName" class="text-red-500 text-sm"></span>
            </div>

            <!-- Actions -->
            <div class="flex gap-4 pt-4">
                <button type="submit"
                        class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
                    💾 Update
                </button>

                <button type="submit"
                        asp-action="Deletee" asp-controller="AdminTags"
                        class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition">
                    🗑 Delete
                </button>
            </div>
        </form>
    }
    else
    {
        <div class="text-red-600 font-semibold">
            ❌ This tag was not found.
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
